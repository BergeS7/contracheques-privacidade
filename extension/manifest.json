{
  "manifest_version": 3,
  "name": "TudoPDF — Ferramentas PDF e Organizador de Contracheques",
  "short_name": "TudoPDF",
  "version": "2.0.0",
  "description": "Juntar, dividir, converter e organizar PDFs e contracheques de A a Z. Processamento local, sem envio de dados. Por BergeS7.",
  "author": "BergeS7",
  "permissions": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir TudoPDF",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "116"
}
