{
  "manifest_version": 3,
  "name": "Organizador de Contracheques - BergeS7",
  "short_name": "Contracheques A-Z",
  "version": "1.2.0",
  "description": "Organiza qualquer PDF com nomes em ordem alfabética, separando folhas com duas pessoas. 100% local, sem envio de dados.",
  "permissions": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Organizar contracheques",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
